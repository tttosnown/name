};

//dom
const selPaper=document.querySelector("#paperSelect");
const qDom=document.querySelector("#qDom");
const optBox=document.querySelector("#optBox");
const ansWrap=document.querySelector("#ansWrap");
const ansContent=document.querySelector("#ansContent");
const expContent=document.querySelector("#expContent");
const pageInfo=document.querySelector("#pageInfo");
const scoreText=document.querySelector("#scoreText");
const bar=document.querySelector("#bar");
const showAnsBtn=document.querySelector("#showAnsBtn");
const prevBtn=document.querySelector("#prevBtn");
const nextBtn=document.querySelector("#nextBtn");

let currentPaperKey=selPaper.value;
let qList=paperData[currentPaperKey];
let currentIdx=0;
let score=0;

function resetState(){
currentIdx=0;
score=0;
render();
}

function render(){
ansWrap.style.display="none";
optBox.innerHTML="";
const item=qList[currentIdx];
pageInfo.innerText=`第 ${currentIdx+1} / ${qList.length} 题`;
scoreText.innerText=`得分：${score}`;
bar.style.width=((currentIdx+1)/qList.length*100).toFixed(1)+"%";
qDom.innerText=item.q;
ansContent.innerText=item.ans;
expContent.innerText=item.desc;
if(item.type==="fill"){
optBox.innerHTML=`<input class="fill‑input" placeholder="回忆答案，点查看答案核对">`;
}else if(item.type==="single"){
item.options.forEach((optStr,i)=>{
const div=document.createElement("div");
div.className="option‑item";
div.innerText=optStr;
optBox.appendChild(div);
});
}else if(item.type==="judge"){
optBox.innerHTML=`<div class="option‑item">✅正确</div><div class="option‑item">❌错误</div>`;
}
}

selPaper.onchange=()=>{
currentPaperKey=selPaper.value;
qList=paperData[currentPaperKey];
resetState();
};

showAnsBtn.onclick=()=>{ansWrap.style.display="block";};

prevBtn.onclick=()=>{
currentIdx‑‑;
if(currentIdx<0)currentIdx=0;
render();
};

nextBtn.onclick=()=>{
currentIdx++;
if(currentIdx>=qList.length){
alert(`✅试卷完成！一共${qList.length}题，得分：${score}`);
resetState();
return;
}
render();
};

resetState();
</script>
</body>
</html>
